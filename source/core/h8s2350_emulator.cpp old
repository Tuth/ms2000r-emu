        if (channel == 0) {
            m_dac.DADR0 = value;
        } else {
            m_dac.DADR1 = value;
        }
        
        m_dac.output_ready = false;
        m_dac.cycles = 0;
        
        if (m_debug_mode) {
            std::cout << "D/A write channel " << (int)channel << ": 0x" << std::hex << (int)value << std::dec << std::endl;
