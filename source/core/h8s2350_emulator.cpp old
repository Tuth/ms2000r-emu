        auto &e = m_storeLog[m_storeLogPos++ % STORE_LOG_N];
        e.addr = addr;
        e.size = size;
        e.b0 = value & 0xFF;
        e.b1 = (value >> 8) & 0xFF;
        e.b2 = (value >> 16) & 0xFF;
        e.b3 = (value >> 24) & 0xFF;
        e.pc = m_registers.pc;
        
        printf("[STACK-STORE] addr=0x%06X size=%d value=0x%08X PC=0x%06X\n",
               addr, size, value, e.pc);
