}

uint16_t H8S2350Emulator::readHPIData()
{
    // fw11.txt Section 3: HPI handshake flags for firmware compatibility
    // Set HSR.RDF = 1 before read (data available), then clear after read
    m_hpi_registers.HSR |= 0x0001;  // RDF bit - receive data full

    uint16_t data;
    if (!isDSPReady()) {
        // DSP not ready yet - return status indicating DSP will be available
        data = 0x0001;  // Return 0x0001 to indicate DSP not ready but will be available
        if (m_debug_mode) {
            std::cout << "HPI Data read: DSP not ready, returning 0x0001" << std::endl;
        }
    } else {
        // DSP is ready - return normal ACK
        data = 0xAC00;  // Return ACK in high byte for compatibility
        if (m_debug_mode) {
            std::cout << "HPI Data read: 0x" << std::hex << data << std::dec << std::endl;
        }
    }

    // Clear RDF after read
    m_hpi_registers.HSR &= ~0x0001;

    return data;
}

void H8S2350Emulator::writeHPIData(uint16_t data)
{
    // CRITICAL FIX: Handle HPI writes even when DSP is not ready to break firmware polling loops
    // The firmware expects DSP communication to work even during early initialization
    // if (!isDSPReady()) {
    //     return;
    // }

    // Simple HPI data writing
    m_hpi_registers.HDR = data;

    // fw11.txt HPI byte-order auto-detection and forwarding to Panel-MP bridge
    if (m_hpi_tx_cb) {
        // fw11.txt Section 1: HPI byte-order auto-detection (hi/lo vs lo/hi)
        enum class HpiOrder { Auto, HiLo, LoHi };
        static HpiOrder g_order = HpiOrder::Auto;
        static int probe_count = 0;
        const int PROBE_LIMIT = 32;  // Auto-detect within first 32 writes

        uint8_t hi = static_cast<uint8_t>(data >> 8);
        uint8_t lo = static_cast<uint8_t>(data & 0xFF);

        if (g_order == HpiOrder::HiLo) {
            m_hpi_tx_cb(hi);
            m_hpi_tx_cb(lo);
            return;
        }
        if (g_order == HpiOrder::LoHi) {
            m_hpi_tx_cb(lo);
            m_hpi_tx_cb(hi);
            return;
        }

        // Auto-detection mode: probe both orders
        if (g_order == HpiOrder::Auto && probe_count < PROBE_LIMIT) {
            // Simple heuristic: check if hi,lo looks more like LCD commands
            bool hiLo_looks_lcd = (hi == 0x38 || hi == 0x0C || hi == 0x01 || hi == 0x06 || (hi & 0x80) == 0x80);
            bool loHi_looks_lcd = (lo == 0x38 || lo == 0x0C || lo == 0x01 || lo == 0x06 || (lo & 0x80) == 0x80);

            if (hiLo_looks_lcd && !loHi_looks_lcd) {
                g_order = HpiOrder::HiLo;
                if (m_debug_mode) {
                    std::cout << "[HPI] fw11.txt: Auto-detected Hi-Lo byte order" << std::endl;
                }
            } else if (loHi_looks_lcd && !hiLo_looks_lcd) {
                g_order = HpiOrder::LoHi;
                if (m_debug_mode) {
                    std::cout << "[HPI] fw11.txt: Auto-detected Lo-Hi byte order" << std::endl;
                }
            }
            probe_count++;
        }

        // Default: send both bytes in hi-lo order during auto-detection
        m_hpi_tx_cb(hi);
        m_hpi_tx_cb(lo);
    }

    // fw11.txt Section 3: HPI handshake flags for firmware compatibility
    // Set HSR.TXDE = 1 (TX Data Empty - ready for next write)
    m_hpi_registers.HSR |= 0x0002;  // TXDE bit

    if (m_debug_mode) {
        std::cout << "HPI Data written: 0x" << std::hex << data << std::dec << std::endl;
    }
}

bool H8S2350Emulator::isHPIReady() const
{
    // CRITICAL FIX: Return true when DSP is ready OR DSP is nullptr (deferred initialization)
    // This allows HPI communication to work even during early initialization while properly detecting DSP state
    return (isDSPReady() || m_dsp == nullptr) && (m_hpi_registers.HSR & 0x0001) != 0;
}

