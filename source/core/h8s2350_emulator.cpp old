uint16_t H8S2350Emulator::readHPIRegister(uint8_t reg)
{
    switch (reg) {
        case 0x00: // HCR - HPI Control Register
            return m_hpi_registers.HCR;
        case 0x01: // HSR - HPI Status Register
            return m_hpi_registers.HSR;
        case 0x02: // HOR - HPI Offset Register
            return m_hpi_registers.HOR;
        case 0x03: // HDR - HPI Data Register
            return readHPIData();
        case 0x04: // HTR - HPI Transfer Register
            return m_hpi_registers.HTR;
        case 0x05: // HIR - HPI Interrupt Register
            return m_hpi_registers.HIR;
        default:
            if (m_debug_mode) {
                std::cout << "Unknown HPI register read: 0x" << std::hex << (int)reg << std::dec << std::endl;
            }
            return 0x0000;
    }
}

void H8S2350Emulator::writeHPIRegister(uint8_t reg, uint16_t value)
{
    switch (reg) {
        case 0x00: // HCR - HPI Control Register
            m_hpi_registers.HCR = value;
            if (m_debug_mode) {
                std::cout << "HPI Control Register written: 0x" << std::hex << value << std::dec << std::endl;
            }
            break;
        case 0x01: // HSR - HPI Status Register
            m_hpi_registers.HSR = value;
            break;
        case 0x02: // HOR - HPI Offset Register
            m_hpi_registers.HOR = value;
            if (m_debug_mode) {
                std::cout << "HPI Offset Register written: 0x" << std::hex << value << std::dec << std::endl;
            }
            break;
        case 0x03: // HDR - HPI Data Register
            writeHPIData(value);
            break;
        case 0x04: // HTR - HPI Transfer Register
            m_hpi_registers.HTR = value;
            break;
        case 0x05: // HIR - HPI Interrupt Register
            m_hpi_registers.HIR = value;
            break;
        default:
            if (m_debug_mode) {
                std::cout << "Unknown HPI register write: 0x" << std::hex << (int)reg 
                          << " = 0x" << value << std::dec << std::endl;
            }
            break;
    }
}

void H8S2350Emulator::sendHPICommand(uint16_t command)
{
    // CRITICAL FIX: Handle HPI commands even when DSP is not ready to break firmware polling loops
    // The firmware expects DSP communication to work even during early initialization
    // if (!isDSPReady()) {
    //     if (m_debug_mode) {
    //         std::cout << "HPI Command failed - DSP not ready" << std::endl;
