+	void DSP::execInterruptsByPriority()
+	{
+		// Serve the pending request with the highest level that the SR mask permits, and among those the
+		// lowest rank. See setInterruptPriorityFunc. Custom interrupts are emulator callbacks, not DSP
+		// interrupts: they go first, as they do without a priority function.
+		const auto mask = static_cast<int>(mr().var & 3);
+		const size_t count = m_pendingInterrupts.size();
+
+		size_t best = count;
+		InterruptPriority bestPrio;
+		bool anyDisabled = false;
+
+		for(size_t i=0; i<count; ++i)
+		{
+			const TWord vba = m_pendingInterrupts[i];
+
+			if(vba >= Vba_End)
+			{
+				best = i;
+				bestPrio.level = 4;
+				break;
+			}
+
+			const auto p = m_interruptPriorityFunc(vba);
+
+			if(p.level < 0)
+			{
+				anyDisabled = true;
+				continue;	// disabled, dropped below
+			}
+			if(p.level < 3 && p.level < mask)
+				continue;	// masked, stays pending
+
+			if(best == count || p.level > bestPrio.level || (p.level == bestPrio.level && p.rank < bestPrio.rank))
+			{
+				best = i;
+				bestPrio = p;
+			}
+		}
+
+		// A request from a source whose level is "disabled" in IPRC/IPRP is not an interrupt. Drop it,
+		// keeping the order of the others: compact towards the back, then pop the front.
+		if(anyDisabled)
+		{
+			size_t w = count;
+			for(size_t i=count; i-- > 0;)
+			{
+				const TWord vba = m_pendingInterrupts[i];
+				if(vba < Vba_End && m_interruptPriorityFunc(vba).level < 0)
+					continue;
+				--w;
+				m_pendingInterrupts[w] = vba;
+				if(i == best)
+					best = w;		// the chosen one is never a disabled one
+			}
+			for(size_t i=0; i<w; ++i)
+				m_pendingInterrupts.pop_front();
+			best = (best == count) ? m_pendingInterrupts.size() : best - w;
+		}
+
+		if(best >= m_pendingInterrupts.size())
+		{
+			// Nothing may be taken now. The requests wait, and the peripherals keep their clock meanwhile.
+			if(m_pendingInterrupts.empty())
+				m_interruptFunc = m_execPeripheralsFunc;
+			m_execPeripheralsFunc(this);
+			return;
+		}
+
+		// move the chosen request to the front, the others keep their order
+		const TWord vba = m_pendingInterrupts[best];
+		for(size_t i=best; i>0; --i)
+			m_pendingInterrupts[i] = m_pendingInterrupts[i-1];
+		m_pendingInterrupts[0] = vba;
+
+		if(vba >= Vba_End)
+		{
+			m_customInterrupts[vba - Vba_End]();
+
+			m_processingMode = Default;
+			m_pendingInterrupts.pop_front();
+			m_interruptFunc = m_pendingInterrupts.empty() ? m_execPeripheralsFunc : &dspExecInterrupts;
+			return;
+		}
+
+		m_processingMode = FastInterrupt;
+		m_pendingInterrupts.pop_front();
+
+		execInterrupt(vba);
+	}
+
+	void DSP::onLongInterruptFormed(const TWord _vba)
+	{
+		// FM 2-14: the JSR of a long interrupt stacks PC and SR (done by the JSR itself) and updates the mask
+		// to hold off the same and lower levels. Table 5-1: I = n permits n..3, so level L gives I = L+1, and
+		// level 3 cannot be masked (I = 3).
+		const auto level = std::max(0, std::min(3, m_interruptPriorityFunc(_vba).level));
+		const auto newMask = static_cast<TWord>(std::min(level + 1, 3));
+
+		reg.sr.var = (reg.sr.var & ~static_cast<TWord>(0x300)) | (newMask << 8);
+
+		// The routine is ordinary code from here on, guarded by the mask - interrupts of a higher level may
+		// nest into it and the peripherals keep running.
+		m_processingMode = Default;
+		m_interruptFunc = m_pendingInterrupts.empty() ? m_execPeripheralsFunc : &dspExecInterrupts;
+	}
+
 	void DSP::execDefaultPreventInterrupt()
 	{
 		m_processingMode = Default;
