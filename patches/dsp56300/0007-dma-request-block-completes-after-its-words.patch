 		verify(dsp.memory().get(MemArea_Y, 0x600) == 0);
 
+		for(TWord i=0; i<64; ++i)
+			emitToMemory("nop", 0xe00 + i);
+		emitToMemory(0x0c0e40, 0, 0xe40);	// jmp $e40, the JIT runs whole blocks, it has to end somewhere
+
+		// FM rev.5 10.2 (RENDERED p.185): a word transfer takes at least two core cycles, and 10.2.1: one channel at a
+		// time. Channel 0's words are there at once (as for DE triggered blocks), but its block is done - DE cleared,
+		// and the "transfer done" that requests channel 1 - only 8 cycles later
 		dma.trigger(DmaChannel::RequestSource::ExternalIRQD);
 
+		for(TWord i=0; i<4; ++i)
+			verify(dsp.memory().get(MemArea_Y, 0x600 + i) == 0x180 + i);
+		verify(dsp.memory().get(MemArea_Y, 0x604) == 0);
+		verify((peripheralsX.read(XIO_DCR0, Nop) & (1 << 23)) != 0);
+
+		auto runCycles = [&]()
+		{
+			dsp.setPC(0xe00);
+			execUntil(0xe40);
+			dma.exec();
+		};
+
+		runCycles();		// channel 0 done -> channel 1 requested
+		runCycles();		// channel 1 done
+
